{"id": "referral-speech-en-001", "language": "en", "doc_type": "referral", "split": "train", "provenance": "made-up", "license": "CC BY 4.0 (project-authored)", "slp_reviewed": true, "reviewed_by": "CCC-SLP (anonymous)", "review_date": "2026-11-11", "source": "Referral letter (made-up example)", "original": "You have been referred to Outpatient Speech-Language Pathology at Riverside Rehabilitation Center for evaluation and treatment of expressive aphasia. Please contact the scheduling department at (919) 555-0142 within 5 business days to arrange your initial appointment. Please bring your insurance card, a photo ID, and a list of your current medications. Riverside Rehabilitation Center is located at 410 Oak Street, Suite 200.", "target": {"title": "Speech therapy", "language": "en", "source": "Referral letter (made-up example)", "pages": [{"topic": "Speech therapy", "lines": [{"kind": "text", "text": "**Speech therapy** can help you **talk**.", "picture": "speech therapist"}, {"kind": "text", "text": "Your **doctor** wants you to go.", "picture": "doctor"}, {"kind": "text", "text": "The place is **Riverside Rehabilitation Center**.", "picture": "hospital"}]}, {"topic": "Call to make a visit", "lines": [{"kind": "text", "text": "**Call** to make a **visit**.", "picture": "phone"}, {"kind": "phone", "text": "Phone: (919) 555-0142", "picture": "phone"}, {"kind": "text", "text": "Call in the next **5 business days**.", "picture": "calendar"}]}, {"topic": "What to bring", "lines": [{"kind": "step", "text": "Your **insurance card**.", "picture": "insurance card"}, {"kind": "step", "text": "Your **photo ID**.", "picture": "identity card"}, {"kind": "step", "text": "A **list** of your **medicines**.", "picture": "medicine list"}]}, {"topic": "Where to go", "lines": [{"kind": "text", "text": "**Riverside Rehabilitation Center**", "picture": "hospital"}, {"kind": "text", "text": "**410 Oak Street, Suite 200**", "picture": "map"}, {"kind": "phone", "text": "Questions? Call (919) 555-0142", "picture": "phone"}]}], "notes_for_reviewer": ["'expressive aphasia' was not named; the page says speech therapy helps you talk."]}}
{"id": "discharge-stroke-en-001", "language": "en", "doc_type": "discharge", "split": "train", "provenance": "made-up", "license": "CC BY 4.0 (project-authored)", "slp_reviewed": true, "reviewed_by": "CCC-SLP (anonymous)", "review_date": "2026-11-11", "source": "Discharge instructions (made-up example)", "original": "Discharge Instructions. You were treated for an ischemic stroke. Take clopidogrel 75 mg by mouth once daily. Do not stop taking this medication unless instructed by your physician. Follow up with Dr. Maria Chen in Neurology on Tuesday, December 8 at 10:30 a.m. Call 911 immediately if you experience sudden face drooping, arm weakness, or difficulty speaking. For non-urgent questions, call the Neurology clinic at (919) 555-0187.", "target": {"title": "Going home after your stroke", "language": "en", "source": "Discharge instructions (made-up example)", "pages": [{"topic": "You had a stroke", "lines": [{"kind": "text", "text": "You had a **stroke**.", "picture": "brain"}, {"kind": "text", "text": "The hospital **treated** you.", "picture": "hospital"}, {"kind": "text", "text": "Now you can go **home**.", "picture": "house"}]}, {"topic": "Your medicine", "lines": [{"kind": "text", "text": "Take **clopidogrel 75 mg**.", "picture": "pill"}, {"kind": "text", "text": "Take it **once** every **day**.", "picture": "calendar"}, {"kind": "text", "text": "Swallow it **by mouth**.", "picture": "mouth"}, {"kind": "text", "text": "**Do not stop** unless your doctor says.", "picture": "stop"}]}, {"topic": "See your doctor", "lines": [{"kind": "text", "text": "See **Dr. Maria Chen**.", "picture": "doctor"}, {"kind": "text", "text": "**Tuesday, December 8**", "picture": "calendar"}, {"kind": "text", "text": "**10:30 a.m.**", "picture": "clock"}]}, {"topic": "Emergency", "lines": [{"kind": "text", "text": "Face **drooping**? Arm **weak**? Hard to **speak**?", "picture": "stroke signs"}, {"kind": "crisis", "text": "Call 911 now", "picture": "ambulance"}]}, {"topic": "Questions", "lines": [{"kind": "text", "text": "Have a **question**? It is **not** an emergency?", "picture": "question"}, {"kind": "phone", "text": "Neurology clinic: (919) 555-0187", "picture": "phone"}]}], "notes_for_reviewer": ["'ischemic' was simplified to 'stroke'.", "Check the SLP is happy with 'once every day' for 'once daily'."]}}
{"id": "appointment-es-001", "language": "es", "doc_type": "appointment", "split": "train", "provenance": "made-up", "license": "CC BY 4.0 (project-authored)", "slp_reviewed": true, "reviewed_by": "CCC-SLP (anonymous)", "review_date": "2026-11-11", "source": "Carta de cita (ejemplo inventado)", "original": "Estimado paciente: Le recordamos que tiene una cita de seguimiento en la Clínica de Rehabilitación Central el jueves 14 de enero de 2027 a las 2:15 p.m. con la Dra. Ana Morales. Por favor, llegue 15 minutos antes para completar los formularios de registro. Si necesita cancelar o cambiar su cita, llame al (919) 555-0163 con al menos 24 horas de anticipación.", "target": {"title": "Su cita", "language": "es", "source": "Carta de cita (ejemplo inventado)", "pages": [{"topic": "Usted tiene una cita", "lines": [{"kind": "text", "text": "Usted tiene una **cita**.", "picture": "cita médica"}, {"kind": "text", "text": "Con la **Dra. Ana Morales**.", "picture": "doctora"}, {"kind": "text", "text": "En la **Clínica de Rehabilitación Central**.", "picture": "hospital"}]}, {"topic": "Cuándo", "lines": [{"kind": "text", "text": "**jueves 14 de enero de 2027**", "picture": "calendario"}, {"kind": "text", "text": "**2:15 p.m.**", "picture": "reloj"}]}, {"topic": "Llegue temprano", "lines": [{"kind": "text", "text": "Llegue **15 minutos antes**.", "picture": "reloj"}, {"kind": "text", "text": "Va a **llenar** unos **papeles**.", "picture": "formulario"}]}, {"topic": "¿No puede ir?", "lines": [{"kind": "text", "text": "¿Necesita **cancelar** o **cambiar** la cita?", "picture": "cancelar"}, {"kind": "text", "text": "**Llame** por lo menos **24 horas** antes.", "picture": "teléfono"}, {"kind": "phone", "text": "Teléfono: (919) 555-0163", "picture": "teléfono"}]}], "notes_for_reviewer": []}}
{"id": "medication-en-001", "language": "en", "doc_type": "medication", "split": "train", "provenance": "made-up", "license": "CC BY 4.0 (project-authored)", "slp_reviewed": true, "reviewed_by": "CCC-SLP (anonymous)", "review_date": "2026-11-11", "source": "Medication instructions (made-up example)", "original": "Atorvastatin 40 mg tablet. Take 1 tablet by mouth every evening. This medication lowers cholesterol to reduce your risk of another stroke. Avoid grapefruit and grapefruit juice while taking this medication. Contact your pharmacist at (919) 555-0119 if you experience unexplained muscle pain or weakness.", "target": {"title": "Your medicine: atorvastatin", "language": "en", "source": "Medication instructions (made-up example)", "pages": [{"topic": "Your medicine", "lines": [{"kind": "text", "text": "Your medicine is **atorvastatin 40 mg**.", "picture": "pill"}, {"kind": "text", "text": "It **lowers cholesterol**.", "picture": "heart"}, {"kind": "text", "text": "It helps **stop another stroke**.", "picture": "brain"}]}, {"topic": "How to take it", "lines": [{"kind": "text", "text": "Take **1 tablet**.", "picture": "pill"}, {"kind": "text", "text": "Swallow it **by mouth**.", "picture": "mouth"}, {"kind": "text", "text": "Take it every **evening**.", "picture": "evening"}]}, {"topic": "No grapefruit", "lines": [{"kind": "text", "text": "**Do not** eat **grapefruit**.", "picture": "grapefruit"}, {"kind": "text", "text": "**Do not** drink **grapefruit juice**.", "picture": "juice"}]}, {"topic": "Muscle pain?", "lines": [{"kind": "text", "text": "Muscles **hurt** or feel **weak**? You do not know why?", "picture": "muscle pain"}, {"kind": "text", "text": "**Call** your **pharmacist**.", "picture": "pharmacist"}, {"kind": "phone", "text": "Pharmacist: (919) 555-0119", "picture": "phone"}]}], "notes_for_reviewer": []}}
{"id": "mental-health-en-001", "language": "en", "doc_type": "mental_health", "split": "train", "provenance": "made-up", "license": "CC BY 4.0 (project-authored)", "slp_reviewed": true, "reviewed_by": "CCC-SLP (anonymous)", "review_date": "2026-11-11", "source": "Support resources handout (made-up example)", "original": "Feeling down after a stroke is common. Many survivors experience sadness, frustration, or loss of interest in activities they once enjoyed. Talk to your doctor if these feelings last more than two weeks. The Stroke Survivors Group meets every Wednesday at 6:00 p.m. at the Cary Community Center; call (919) 555-0175 for details. If you are thinking about hurting yourself, call or text 988 to reach the 988 Suicide & Crisis Lifeline, available 24 hours a day.", "target": {"title": "Feeling sad after a stroke", "language": "en", "source": "Support resources handout (made-up example)", "pages": [{"topic": "Feeling sad is common", "lines": [{"kind": "text", "text": "Many people feel **sad** after a **stroke**.", "picture": "sad face"}, {"kind": "text", "text": "You may feel **frustrated**.", "picture": "frustrated"}, {"kind": "text", "text": "Things you liked may feel **less fun**.", "picture": "hobby"}]}, {"topic": "Talk to your doctor", "lines": [{"kind": "text", "text": "Sad for **more than two weeks**?", "picture": "calendar"}, {"kind": "text", "text": "**Talk** to your **doctor**.", "picture": "doctor"}]}, {"topic": "A group can help", "lines": [{"kind": "text", "text": "The **Stroke Survivors Group** meets.", "picture": "group"}, {"kind": "text", "text": "Every **Wednesday** at **6:00 p.m.**", "picture": "calendar"}, {"kind": "text", "text": "At the **Cary Community Center**.", "picture": "building"}, {"kind": "phone", "text": "Phone: (919) 555-0175", "picture": "phone"}]}, {"topic": "Help now", "lines": [{"kind": "text", "text": "Thinking about **hurting yourself**?", "picture": "help"}, {"kind": "crisis", "text": "Call or text 988 — 988 Suicide & Crisis Lifeline", "picture": "phone"}, {"kind": "text", "text": "Help is there **24 hours a day**.", "picture": "clock"}]}], "notes_for_reviewer": ["Crisis line kept word for word."]}}
